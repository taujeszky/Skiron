{
  "name": "skiron",
  "version": "0.1.0",
  "description": "Murder-mystery deduction puzzles that are provably fair",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "sim": "vite-node --config vitest.config.ts tools/sim.mjs",
    "par": "vite-node --config vitest.config.ts tools/par.mjs",
    "playthrough": "node tools/playthrough.mjs",
    "offline": "node tools/offline.mjs",
    "inspect": "vite-node --config vitest.config.ts tools/inspect.mjs",
    "author": "vite-node --config vitest.config.ts tools/author-case.mjs",
    "ask": "vite-node --config vitest.config.ts tools/interrogate-cost.mjs",
    "postinstall": "node scripts/patch-workerd.cjs",
    "deploy": "npm run build && wrangler pages deploy build --project-name=skiron"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^24.12.4",
    "svelte": "5.56.8",
    "svelte-check": "4.7.3",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "@google/genai": "2.6.0"
  }
}
